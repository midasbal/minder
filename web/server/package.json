{
  "name": "minder-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Minder relay: serves the built frontend and the API from one port.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
